{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mediaclinic-settings-v0.19.1",
  "title": "MediaClinic Settings",
  "description": "Schema for settings.json written by mediaclinic/settings_controller.py",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ffmpeg_path":           { "type": "string", "default": "" },
    "text_editor":           { "type": "string", "default": "" },
    "scraper_path":          { "type": "string", "default": "" },
    "last_folder":           { "type": "string", "default": "",
                               "description": "First library folder (kept for compatibility with v0.18.x)" },
    "last_results":          { "type": "array",  "default": [],
                               "description": "Deprecated since v0.18.3 — scan results now live in last_results.json next to this file; key kept empty for compatibility" },
    "sort_option":           {
      "type": "string",
      "default": "Movie Name (A-Z)",
      "examples": ["Movie Name (A-Z)", "Movie Name (Z-A)", "Year (Newest)", "Year (Oldest)"]
    },
    "extract_timeout":       { "type": "integer", "minimum": 5,  "maximum": 600,  "default": 60 },
    "use_ffprobe":           { "type": "boolean", "default": true },
    "lang_ok_code":          { "type": "string",  "minLength": 2, "maxLength": 2, "default": "PT",
                               "description": "ISO 639-1 language code for the Lang OK? column" },
    "improve_checks": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "large_xml":      { "type": "boolean", "default": true },
        "nfo_xml_diff":   { "type": "boolean", "default": true },
        "ffprobe_diff":   { "type": "boolean", "default": true },
        "poster_folder":  { "type": "boolean", "default": true },
        "proportions":    { "type": "boolean", "default": true },
        "backdrops":      { "type": "boolean", "default": true }
      }
    },
    "max_nfo_kb":            { "type": "integer", "minimum": 1,  "maximum": 9999, "default": 50 },
    "max_xml_kb":            { "type": "integer", "minimum": 1,  "maximum": 9999, "default": 25 },
    "min_backdrops":         { "type": "integer", "minimum": 1,  "maximum": 50,   "default": 5  },
    "tag_pairs": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              { "type": "string", "description": "NFO dot-path" },
              { "type": "string", "description": "XML dot-path" },
              { "type": "string", "description": "Human label" },
              { "type": "integer", "minimum": 0, "maximum": 100,
                "description": "Numeric tolerance %" }
            ]
          }
        }
      ],
      "default": null,
      "description": "null = use DEFAULT_TAG_PAIRS from settings_model.py"
    },
    "tmdb_api_key":          { "type": "string", "default": "" },
    "omdb_api_key":          { "type": "string", "default": "" },
    "fanarttv_api_key":      { "type": "string", "default": "",
                               "description": "Personal fanart.tv API key (v0.19.1 I10)" },
    "fanarttv_client_key":   { "type": "string", "default": "",
                               "description": "Optional fanart.tv VIP client key (v0.19.1 I10)" },
    "default_browser":       { "type": "string", "default": "",
                               "description": "Path to browser exe; empty = system default" },
    "min_poster_kb":         { "type": "integer", "minimum": 0, "default": 100 },
    "min_folder_kb":         { "type": "integer", "minimum": 0, "default": 100 },
    "min_fanart_kb":         { "type": "integer", "minimum": 0, "default": 200 },
    "backdrop_count":        { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "alternating_rows":      { "type": "boolean", "default": true },
    "show_header_tips":      { "type": "boolean", "default": true },
    "poster_quality_level": {
      "description": "Mirror of health_rules.poster_folder_quality_level since v0.19.0 (Health Rules are authoritative)",
      "type": "string",
      "enum": ["4K", "1440p", "1080p", "720p", "540p", "480p", "360p"],
      "default": "1080p"
    },
    "folder_quality_level": {
      "description": "Mirror of health_rules.poster_folder_quality_level since v0.19.0",
      "type": "string",
      "enum": ["4K", "1440p", "1080p", "720p", "540p", "480p", "360p"],
      "default": "1080p"
    },
    "fanart_quality_level": {
      "description": "Mirror of health_rules.fanart_quality_level_minimum since v0.19.0",
      "type": "string",
      "enum": ["4K", "1440p", "1080p", "720p", "540p", "480p", "360p"],
      "default": "1080p"
    },
    "fanart_accept_168":     { "type": "boolean", "default": false,
                               "description": "Accept 16:8 (~1.50) ratio as valid for fanart" },
    "poster_accept_34":      { "type": "boolean", "default": false,
                               "description": "Accept 3:4 (0.75) ratio as valid for poster/folder" },
    "show_image_size":       { "type": "boolean", "default": false },
    "genre_list":            { "type": "string",  "default": "",
                               "description": "Newline-separated genre names" },
    "metadata_source":       { "type": "string",  "enum": ["tmdb", "omdb"], "default": "tmdb" },
    "max_backup_size_mb":    { "type": "integer", "minimum": 0, "default": 500,
                               "description": "0 = disable automatic backup cleanup" },
    "backup_cleanup_enabled":{ "type": "boolean", "default": true },
    "compact_mode":          { "type": "boolean", "default": false },
    "dark_theme":            { "type": "boolean", "default": true },
    "auto_fit_columns":      { "type": "boolean", "default": true },
    "rating_apply_all_movies": { "type": "boolean", "default": false },
    "rating_use_more_votes":   { "type": "boolean", "default": false },
    "column_widths": {
      "type": "object",
      "default": {},
      "description": "Persisted column widths keyed by column id (string → integer pixels)",
      "additionalProperties": { "type": "number" }
    },
    "scan_workers":          { "type": "integer", "minimum": 1, "maximum": 16, "default": 6,
                               "description": "Parallel workers for listing, image and metadata phases (v0.18.4)" },
    "ffprobe_workers":       { "type": "integer", "minimum": 1, "maximum": 8,  "default": 2,
                               "description": "Parallel ffprobe processes during video phases (v0.18.4)" },
    "hidden_columns":        { "type": "array", "default": ["library"], "items": { "type": "string" },
                               "description": "Column ids hidden via Tools → Choose Columns (v0.18.4); the Library column is hidden by default (v0.19.0)" },
    "library_folders":       { "type": "array", "default": [], "items": { "type": "string" },
                               "description": "Library (root) folders, scanned into one table; migrated from last_folder on the first v0.19.0 run (v0.19.0)" },
    "library_filter":        { "type": "string", "default": "",
                               "description": "Library shown and scanned; empty = all libraries (v0.19.0)" },
    "window_geometry": {
      "type": "object",
      "default": {},
      "description": "Saved size/position per window id (class name, plus a suffix for shared classes such as TextReportDialog:<stem>) (v0.19.0)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "geometry": { "type": "string", "pattern": "^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$" },
          "zoomed":   { "type": "boolean", "default": false }
        }
      }
    },
    "ffprobe_cache_enabled": { "type": "boolean", "default": true,
                               "description": "v0.19.1: remember FFprobe results in ffprobe_cache.json (path + size + mtime); unchanged videos are not probed again" },
    "api_pauses": {
      "type": "object",
      "default": {},
      "description": "v0.19.1: per-service pause after a rate limit / daily limit / repeated server error; written only when a pause starts or ends, expired entries dropped on start",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "until":   { "type": "string" },
          "kind":    { "type": "string", "enum": ["rate_limited", "daily_limit", "invalid_key", "offline", "server_error", "timeout"] },
          "message": { "type": "string" }
        }
      }
    },
    "export_prefs": {
      "type": "object",
      "default": {},
      "description": "Last choices of the Export Movie List dialog (v0.18.3): preset, fields, format, scope",
      "additionalProperties": true
    },
    "health_rules": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "description": "Configurable health rule engine settings (v0.18.2, extended v0.18.3)",
      "properties": {
        "missing_video_file":              { "type": "boolean", "default": true },
        "corrupt_nfo":                     { "type": "boolean", "default": true },
        "missing_nfo":                     { "type": "boolean", "default": true },
        "corrupt_xml":                     { "type": "boolean", "default": true },
        "missing_xml":                     { "type": "boolean", "default": true },
        "corrupt_poster":                  { "type": "boolean", "default": true },
        "corrupt_fanart":                  { "type": "boolean", "default": true },
        "corrupt_folder":                  { "type": "boolean", "default": true },
        "missing_imdb_id":                 { "type": "boolean", "default": true },
        "corrupt_imdb_id":                 { "type": "boolean", "default": true },
        "missing_tmdb_id":                 { "type": "boolean", "default": true },
        "single_source_level":             { "type": "string", "enum": ["error", "warning", "off"], "default": "error", "description": "v0.19.1: how a movie with only an IMDb or only a TMDb ID is reported" },
        "no_source_level":                 { "type": "string", "enum": ["error", "warning", "off"], "default": "error", "description": "v0.19.1: how a movie with no IMDb and no TMDb ID is reported" },
        "corrupt_tmdb_id":                 { "type": "boolean", "default": true },
        "rating_conflict":                 { "type": "boolean", "default": true },
        "no_audio_tracks":                 { "type": "boolean", "default": true },
        "video_quality_minimum":           { "type": "boolean", "default": true },
        "video_quality_minimum_level":     { "type": "string",  "default": "720p" },
        "votes_conflict":                  { "type": "boolean", "default": true },
        "genre_missing":                   { "type": "boolean", "default": true },
        "missing_movie_year":              { "type": "boolean", "default": true },
        "multiple_video_files":            { "type": "boolean", "default": false },
        "imdb_id_partial":                 { "type": "boolean", "default": true },
        "tmdb_id_partial":                 { "type": "boolean", "default": true },
        "duplicate_movie":                 { "type": "boolean", "default": true },
        "missing_poster":                  { "type": "boolean", "default": true },
        "missing_fanart":                  { "type": "boolean", "default": true },
        "missing_folder":                  { "type": "boolean", "default": true },
        "folder_optional_with_kodi_poster": { "type": "boolean", "default": true, "description": "v0.19.1: no 'Missing folder image' when a Kodi-style poster (<video>-poster.jpg/png, .tbn) exists" },
        "nfo_name_not_kodi":               { "type": "boolean", "default": true, "description": "v0.19.1: warn when the NFO exists only as <folder>.nfo and Kodi (which reads <video>.nfo / movie.nfo) would not find it" },
        "poster_proportion":               { "type": "boolean", "default": true },
        "fanart_proportion":               { "type": "boolean", "default": true },
        "folder_proportion":               { "type": "boolean", "default": true },
        "poster_folder_quality_minimum":   { "type": "boolean", "default": true },
        "poster_folder_quality_level":     { "type": "string",  "default": "1080p" },
        "fanart_quality_minimum":          { "type": "boolean", "default": true },
        "fanart_quality_level_minimum":    { "type": "string",  "default": "1080p" },
        "image_file_too_small":            { "type": "boolean", "default": true,
                                             "description": "Warning when poster/folder/fanart is below min_*_kb (v0.19.0)" },
        "image_format_mismatch":           { "type": "boolean", "default": true,
                                             "description": "Warning when the image signature differs from the extension, e.g. PNG named .jpg (v0.19.0)" },
        "poster_folder_identical":         { "type": "boolean", "default": true },
        "insufficient_backdrops":          { "type": "boolean", "default": true },
        "backdrop_min_count":              { "type": "integer", "minimum": 1, "default": 5 },
        "backdrop_too_small":              { "type": "boolean", "default": true },
        "backdrop_min_avg_kb":             { "type": "integer", "minimum": 1, "default": 20 },
        "missing_rating":                  { "type": "boolean", "default": true },
        "rating_warning":                  { "type": "boolean", "default": true },
        "suspicious_rating":               { "type": "boolean", "default": true },
        "suspicious_rating_threshold":     { "type": "number",  "minimum": 0.0, "default": 1.0 },
        "genre_warning":                   { "type": "boolean", "default": true },
        "genre_only_in_xml":               { "type": "boolean", "default": true, "description": "NFO has no <genre> tags while the XML has genres (v0.19.1)" },
        "genre_only_in_nfo":               { "type": "boolean", "default": true, "description": "XML has no <Genre> tags while the NFO has genres (v0.19.1)" },
        "genre_nfo_wrong_tags":            { "type": "boolean", "default": true, "description": "NFO uses <Genres>/<Genre> (not read by Kodi) (v0.19.1)" },
        "missing_votes":                   { "type": "boolean", "default": true },
        "votes_warning":                   { "type": "boolean", "default": true },
        "lang_not_ok":                     { "type": "boolean", "default": true },
        "missing_language_field":          { "type": "boolean", "default": true },
        "nfo_xml_too_large":               { "type": "boolean", "default": true },
        "required_audio_language":         { "type": "boolean", "default": true },
        "required_audio_language_code":    { "type": "string",  "default": "ENG" },
        "required_subtitle_language":      { "type": "boolean", "default": true },
        "required_subtitle_language_code": { "type": "string",  "default": "POR" },
        "missing_movie_title":             { "type": "boolean", "default": true },
        "title_mismatch":                  { "type": "boolean", "default": true },
        "folder_name_mismatch":            { "type": "boolean", "default": false }
      }
    }
  }
}
